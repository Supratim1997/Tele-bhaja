# TeleBhaja — Environment Configuration
# Copy this file to .env and fill in your values

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ── Media Storage ────────────────────────────────────────────────────────────
# Path to the root of your external hard drive / media folder
# Windows: E:\Movies  |  Linux/macOS: /mnt/media  |  Docker: /media
MEDIA_STORAGE_PATH=E:\Media

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite DB file path (relative to project root or absolute)
DB_PATH=./data/telebhaja.db

# ── TMDb (optional) ──────────────────────────────────────────────────────────
# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# ── Transcoding ───────────────────────────────────────────────────────────────
# Path to ffmpeg and ffprobe executables (leave blank to use system PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# Bitrate target for HLS transcode stream in kbps (video)
TRANSCODE_VIDEO_BITRATE=2000

# Audio target bitrate in kbps
TRANSCODE_AUDIO_BITRATE=128

# Max simultaneous transcode jobs
TRANSCODE_MAX_CONCURRENT=2

# ── Scanner ──────────────────────────────────────────────────────────────────
# Auto-scan on startup (true/false)
SCAN_ON_STARTUP=true

# Cron expression for periodic re-scan (blank = disabled)
# Example: "0 3 * * *" = every day at 3 AM
SCAN_CRON=

# ── Security ─────────────────────────────────────────────────────────────────
# Simple PIN lock for the UI (leave blank to disable)
UI_PIN=
